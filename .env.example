# Database Configuration
# Optional: If unset or commented out, the pipeline defaults to local SQLite (data/crime_analysis.db)
# To connect to MySQL, uncomment and configure the parameters below:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_username
# DB_PASS=your_password
# DB_NAME=your_database
# DATABASE_URL=mysql+pymysql://your_username:your_password@localhost:3306/your_database
